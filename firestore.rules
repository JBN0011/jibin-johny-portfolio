rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects: Public read, open write for portfolio manager
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Journals & Writings: Public read, open write for portfolio manager
    match /journals/{journalId} {
      allow read: if true;
      allow write: if true;
    }

    // Proof Stats & Metrics: Public read, open write
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Config: Public read, open write
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Contact messages: Anyone can create a message
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if true;
    }
  }
}
