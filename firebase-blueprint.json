{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "impact": { "type": "string" },
        "technologies": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "githubUrl": { "type": "string" },
        "liveUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "date": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "summary"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Journal or writing article entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "readTime": { "type": "string" },
        "date": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "summary", "content"]
    },
    "StatItem": {
      "title": "StatItem",
      "description": "Key metric proof stat item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "number" },
        "suffix": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "number", "label"]
    },
    "PortfolioConfig": {
      "title": "PortfolioConfig",
      "description": "Portfolio site global configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "bio": { "type": "string" },
        "email": { "type": "string" },
        "adminPasscode": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "resumeFileName": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "socialLinks": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inbound contact messages from visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Public projects published on the portfolio"
    },
    "/journals/{journalId}": {
      "schema": "JournalEntry",
      "description": "Public writings and engineering notes"
    },
    "/stats/{statId}": {
      "schema": "StatItem",
      "description": "Animated proof metrics and skills highlights"
    },
    "/config/global": {
      "schema": "PortfolioConfig",
      "description": "Global portfolio configuration"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Messages sent from the Contact form"
    }
  }
}
